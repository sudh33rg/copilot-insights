{
  "name": "copilot-insights",
  "displayName": "Copilot Insights",
  "description": "Local observability and efficiency analysis for native GitHub Copilot Chat sessions in VS Code.",
  "version": "0.2.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onView:copilotInsights.sidebar",
    "onCommand:copilotInsights.openDashboard",
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copilotInsights.openDashboard",
        "title": "Copilot Insights: Open Dashboard",
        "icon": "$(graph)"
      },
      {
        "command": "copilotInsights.syncUsage",
        "title": "Copilot Insights: Sync GitHub Usage",
        "icon": "$(sync)"
      },
      {
        "command": "copilotInsights.syncSessions",
        "title": "Copilot Insights: Refresh Native Copilot Sessions",
        "icon": "$(history)"
      },
      {
        "command": "copilotInsights.clearTraces",
        "title": "Copilot Insights: Clear Local Traces",
        "icon": "$(trash)"
      },
      {
        "command": "copilotInsights.setGithubToken",
        "title": "Copilot Insights: Set GitHub Token"
      },
      {
        "command": "copilotInsights.exportData",
        "title": "Copilot Insights: Export Usage Data"
      },
      {
        "command": "copilotInsights.enableExactTelemetry",
        "title": "Copilot Insights: Enable Exact Copilot Token/Cache Telemetry"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copilotInsights",
          "title": "AI Usage",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "copilotInsights": [
        {
          "id": "copilotInsights.sidebar",
          "name": "Copilot Insights",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Copilot Insights",
      "properties": {
        "copilotInsights.captureLevel": {
          "type": "string",
          "enum": [
            "metrics",
            "summaries",
            "full"
          ],
          "default": "full",
          "enumDescriptions": [
            "Store only usage metadata and token counts.",
            "Store compact local prompt/result summaries in addition to metrics.",
            "Store complete prompts and responses locally."
          ],
          "description": "Content retained after parsing native GitHub Copilot Chat sessions. Full retains exact prompts/responses; summaries keeps compact text; metrics removes conversation text."
        },
        "copilotInsights.retentionDays": {
          "type": "number",
          "enum": [
            0,
            7,
            30,
            90,
            365
          ],
          "default": 30,
          "description": "Days to retain local session details. 0 keeps data indefinitely."
        },
        "copilotInsights.githubScope": {
          "type": "string",
          "enum": [
            "auto",
            "user",
            "organization",
            "enterprise",
            "off"
          ],
          "default": "auto",
          "description": "Source used to sync authoritative GitHub AI-credit usage."
        },
        "copilotInsights.githubOrganization": {
          "type": "string",
          "default": "",
          "description": "GitHub organization used for organization-scoped usage metrics."
        },
        "copilotInsights.githubEnterprise": {
          "type": "string",
          "default": "",
          "description": "GitHub enterprise slug used for enterprise-scoped usage metrics."
        },
        "copilotInsights.syncDays": {
          "type": "number",
          "minimum": 1,
          "maximum": 90,
          "default": 30,
          "description": "Number of recent days to refresh when syncing usage metrics."
        },
        "copilotInsights.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Sync GitHub usage after a user opens the dashboard (at most every six hours)."
        },
        "copilotInsights.nativeStorageRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Optional additional VS Code workspaceStorage roots to scan for GitHub Copilot Chat traces."
        },
        "copilotInsights.nativeRefreshSeconds": {
          "type": "number",
          "minimum": 15,
          "maximum": 600,
          "default": 60,
          "description": "Background refresh interval for native Copilot session traces."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "copilotInsights.openDashboard",
          "when": "view == copilotInsights.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "copilotInsights.syncUsage",
          "when": "view == copilotInsights.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "copilotInsights.syncSessions",
          "when": "view == copilotInsights.sidebar",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "package:zip": "node scripts/package-zip.js"
  }
}
