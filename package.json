{
  "name": "traceon",
  "displayName": "TraceOn",
  "description": "Local observability and optimization for native GitHub Copilot Chat sessions in VS Code.",
  "version": "0.8.0",
  "publisher": "local",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/sudh33rg/copilot-insights"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "vscode": "^1.105.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copilotInsights.openDashboard",
        "title": "Open Dashboard",
        "category": "TraceOn",
        "icon": "$(graph)"
      },
      {
        "command": "copilotInsights.refreshSessions",
        "title": "Refresh Copilot Sessions",
        "category": "TraceOn",
        "icon": "$(refresh)"
      },
      {
        "command": "copilotInsights.rebuildIndex",
        "title": "Rebuild Session Index",
        "category": "TraceOn"
      },
      {
        "command": "copilotInsights.clearData",
        "title": "Clear Data…",
        "category": "TraceOn"
      },
      {
        "command": "copilotInsights.exportData",
        "title": "Export Index as JSON…",
        "category": "TraceOn"
      },
      {
        "command": "copilotInsights.deleteLegacyData",
        "title": "Delete Data From Previous Version…",
        "category": "TraceOn"
      },
      {
        "command": "copilotInsights.syncGithubUsage",
        "title": "Sync GitHub Usage",
        "category": "TraceOn"
      },
      {
        "command": "copilotInsights.enableDebugLogging",
        "title": "Enable Exact Telemetry…",
        "category": "TraceOn"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "copilotInsights",
          "title": "TraceOn",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "copilotInsights": [
        {
          "id": "copilotInsights.sidebar",
          "name": "Overview",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "copilotInsights.openDashboard",
          "when": "view == copilotInsights.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "copilotInsights.refreshSessions",
          "when": "view == copilotInsights.sidebar",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "TraceOn",
      "properties": {
        "copilotInsights.retentionDays": {
          "type": "number",
          "enum": [
            0,
            7,
            30,
            90,
            365
          ],
          "default": 30,
          "markdownDescription": "Days of session history to keep. `0` keeps everything."
        },
        "copilotInsights.nativeRefreshSeconds": {
          "type": "number",
          "minimum": 15,
          "maximum": 600,
          "default": 60,
          "markdownDescription": "How often to look for new or changed Copilot chat sessions. Sessions in the current workspace also refresh when their files change."
        },
        "copilotInsights.liveNudge": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show the active Copilot session's context size and credits in the status bar, with a hint when the context has grown a lot."
        },
        "copilotInsights.monthlyCreditBudget": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "markdownDescription": "Monthly Copilot credit budget, measured from credits recorded on this machine. `0` turns budgets off. You are warned at 80% and 100%."
        },
        "copilotInsights.workspaceCreditBudgets": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          },
          "default": {},
          "markdownDescription": "Per-workspace monthly credit budgets keyed by workspace name, for example `{ \"my-app\": 20 }`."
        },
        "copilotInsights.nativeStorageRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra `workspaceStorage` folders to scan, for example another VS Code build's `User/workspaceStorage`."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs && vite build --config vite.config.mjs",
    "build:prod": "node esbuild.mjs --production && vite build --config vite.config.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/integration/tsconfig.json && tsc -p src/webview/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run build",
    "vscode:prepublish": "pnpm run build:prod",
    "package": "vsce package --no-dependencies",
    "test:integration": "pnpm run build && node esbuild.mjs --integration && vscode-test",
    "watch:webview": "vite build --config vite.config.mjs --watch",
    "smoke:real": "node esbuild.mjs --smoke && node out/smokeReal.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "1.105.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "mocha": "^12.0.2",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  }
}
